FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Base tooling + Kitware repo for newer CMake
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg software-properties-common \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://apt.kitware.com/keys/kitware-archive-latest.asc \
      | gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo 'deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ jammy main' > /etc/apt/sources.list.d/kitware.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends kitware-archive-keyring \
    && rm /usr/share/keyrings/kitware-archive-keyring.gpg \
    && apt-get install -y --no-install-recommends \
        build-essential cmake git pkg-config \
        python3 python3-pip gcc g++ ccache ninja-build libzstd-dev mold \
    && rm -rf /var/lib/apt/lists/*

# Conan v1.59.0 (exact pin)
RUN pip3 install --no-cache-dir "conan==1.59.0"

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

# Caches (mounted from host for speed)
ENV CCACHE_DIR=/ccache
ENV CONAN_USER_HOME=/conan
RUN mkdir -p /ccache /conan

WORKDIR /src
