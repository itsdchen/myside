{
  "settings": {
    "commissions": {
      "tiers": {
        "Hyperliquid": "HIP3_3"
      },
      "promo_tier": "Silver",
      "use_promo": true
    },
    // HKEX morning session 09:30-12:00 HKT, translated to ET (the live trader
    // hardcodes America/New_York for its 18:00 day-rollover logic; see
    // trade_main.cc and the is_us_equity() scope note in symbolizer.py).
    // HK has no DST; ET = HKT - 12h during US EDT (summer), - 13h during EST.
    // start_t >= 18:00 ET so the rollover puts the open on the prior calendar
    // day (D-1), end 00:00 ET lands on the L1Date (D) = 12:00 HKT.
    // !!! EDT-ONLY VALUES — revisit at the next US DST change (Nov 2026):
    //     EST mapping would be 20:30 -> 23:00 ET (both on D-1).
    "start_t": "21:30:00 America/New_York",
    "end_t": "00:00:00 America/New_York"
  },
  "simulation": {
    "Hyperliquid": {
      "cxl_frac_ahead": 0.3,
      "use_one_way_latency": false,
      "sim_latency_secs": 1.0
    }
  },
  "pktraders": [
    {
      "traded_symbol": "xyz:MINIMAX",
      "enabled": true,
      "size_mult": 1,
      "risk": {
        "max_notional": 20000,
        // max_position ~= tgt_maxpos_notional / price (~$53.4 = 417.4 HKD / 7.81).
        "max_position": "400",
        "max_orders": 30,
        "base_currency": "USDT",
        "global_inherit": true,
        "min_pnl": -1000,
        "fv_limit": 2,
        "timeout_minfv": 900
      },
      "ordex": {
        "type": "RelWideMM2",
        "markets": [
          "Hyperliquid"
        ],
        "trade_caller": "remote_tradecall_tempo_minimax",
        "riskfree_rate": 0,
        // Share counts are notional-driven at runtime; these are rounded
        // estimates off the ~$53.4 USD price (day one, no historical data).
        "max_pos": "400",
        "order_size": "40",
        "tgt_order_notional": 2000,
        "tgt_maxpos_notional": 20000,
        "max_back_levels": 6,
        "front_rung_spacing_mult": 0.5,
        "rung_spacing_mult": 1.0,
        "per_backlevel_rung_spacing_mult": 2.5,
        "front_order_random_upper_limit": 1.3,
        "front_order_random_lower_limit": 0.7,
        "order_random_upper_limit": 1.2,
        "order_random_lower_limit": 0.8,
        "can_cross": false,
        "cross_thresh": 0.0045,
        "ms_between_cross": 500,
        "cross_limit_maxpos_frac": 0.1,
        "ms_between_place": 250,
        "ms_between_cxl": 50,
        "local_sig": "local_mid_minimax",
        "remote_sig": "remote_mid_minimax",
        "min_ord_lifetime": 0.5,
        // Day one: flat 10 bps threshold (1 HKEX tick at ~417 HKD is ~4.8 bps,
        // so ~2 ticks). No historical spread table available; tune live.
        "place_thresh": 0.0010,
        "cancel_buffer": 0.3,
        "thresh_mult_minfv": 1.5,
        "extra_buy_thresh": 0.0,
        "extra_sell_thresh": 0.0,
        // Momentum / premium / vol-norm from the playbook sym-population survey
        // and usday systematic learnings (premium_ema 0.9, premium_tdc 60,
        // momentum tdc 5 / coef 0.5, vol_norm tdc 10 / coef 0.1, curv off).
        "premium_ema_coef": 0.9,
        "premium_tdc_s": 60,
        "curv_impulse_tdc": 30,
        "curv_impulse_coef": 0.0,
        "pred_momentum_tdc": 5,
        "pred_momentum_coef": 0.5,
        "vol_norm_tdc": 10,
        "vol_norm_coef": 0.1,
        "enable_queue_jump": false,
        "queue_jump_size_mult": 3,
        "equity_off_hour_vwap": false,
        "mm_gtc": false,
        "ladder_one_sided": false,
        "per_order_widen_frac": 0.5,
        "print_ords": true,
        "print_ords_every": 100
      },
      "signals": [
        {
          // Local leg: the Hyperliquid hip3 book we quote on.
          "name": "local_mid_minimax",
          "type": "SigMid",
          "symbol": "xyz:MINIMAX",
          "books": [
            "Hyperliquid"
          ],
          "use_flagged": true,
          "sigformer_tag": "top_level_signal"
        },
        {
          // Remote leg: HKEX 0100.HK fed by Refinitiv, published (FX-converted
          // to USD) into the TopBookEquity book as symbol MINIMAX.
          "name": "remote_mid_minimax",
          "type": "SigQuoteMid",
          "symbol": "MINIMAX",
          "books": [
            "TopBookEquity"
          ],
          "use_flagged": true,
          "sigformer_tag": "top_level_signal"
        }
      ],
      "tempos": [
        {
          // Requote trigger fires on each Refinitiv 0100.HK (MINIMAX) update.
          "name": "remote_tradecall_tempo_minimax",
          "type": "FinalTempo",
          "symbol": "MINIMAX",
          "markets": [
            "TopBookEquity"
          ]
        }
      ],
      "extra_subs": []
    }
  ]
}
