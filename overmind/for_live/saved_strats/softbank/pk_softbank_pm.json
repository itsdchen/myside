{
  "settings": {
    "commissions": {
      "tiers": {
        "Hyperliquid": "HIP3_3"
      },
      "promo_tier": "Silver",
      "use_promo": true
    },
    // TSE afternoon session 12:30-15:30 JST, translated to ET (the live trader
    // hardcodes America/New_York for its 18:00 day-rollover logic; see
    // trade_main.cc and the is_us_equity() scope note in symbolizer.py).
    // Japan has no DST; ET = JST - 13h during US EDT (summer), - 14h during EST.
    // start_t 23:30 ET is on D-1 (>= 18:00 rollover), end 02:30 ET lands on the
    // L1Date (D): 23:30->02:30 ET = 12:30->15:30 JST (crosses midnight ET).
    // !!! EDT-ONLY VALUES — revisit at the next US DST change (Nov 2026):
    //     EST mapping would be 22:30 -> 01:30 ET.
    "start_t": "23:30:00 America/New_York",
    "end_t": "02:30:00 America/New_York"
  },
  "simulation": {
    "Hyperliquid": {
      "cxl_frac_ahead": 0.3,
      "use_one_way_latency": false,
      "sim_latency_secs": 1.0
    }
  },
  "pktraders": [
    {
      "traded_symbol": "xyz:SOFTBANK",
      "enabled": true,
      "size_mult": 1,
      "risk": {
        "max_notional": 20000,
        // max_position ~= tgt_maxpos_notional / price (~$31 USD from the
        // HyperliquidSec.h mid snapshot; reconcile via check_maxpos.py once
        // xyz:SOFTBANK has a live HL mid).
        "max_position": "650",
        "max_orders": 30,
        "base_currency": "USDT",
        "global_inherit": true,
        "min_pnl": -1000,
        "fv_limit": 2,
        "timeout_minfv": 900
      },
      "ordex": {
        "type": "RelWideMM2",
        "markets": [
          "Hyperliquid"
        ],
        "trade_caller": "remote_tradecall_tempo_softbank",
        "riskfree_rate": 0,
        // Share counts are notional-driven at runtime; rounded estimates off the
        // ~$31 USD HL mid snapshot (day one, no historical data; reconcile later).
        "max_pos": "650",
        "order_size": "65",
        "tgt_order_notional": 2000,
        "tgt_maxpos_notional": 20000,
        "max_back_levels": 6,
        "front_rung_spacing_mult": 0.5,
        "rung_spacing_mult": 1.0,
        "per_backlevel_rung_spacing_mult": 2.5,
        "front_order_random_upper_limit": 1.3,
        "front_order_random_lower_limit": 0.7,
        "order_random_upper_limit": 1.2,
        "order_random_lower_limit": 0.8,
        "can_cross": false,
        "cross_thresh": 0.0045,
        "ms_between_cross": 500,
        "cross_limit_maxpos_frac": 0.1,
        "ms_between_place": 250,
        "ms_between_cxl": 50,
        "local_sig": "local_mid_softbank",
        "remote_sig": "remote_mid_softbank",
        "min_ord_lifetime": 0.5,
        // Day one: flat 10 bps placeholder. No historical spread table yet
        // (Refinitiv 9984.T capture just started via pydatalog); tune live once
        // the per-30min-bin spread accrues.
        "place_thresh": 0.0010,
        "cancel_buffer": 0.3,
        "thresh_mult_minfv": 1.5,
        "extra_buy_thresh": 0.0,
        "extra_sell_thresh": 0.0,
        // Momentum / premium / vol-norm from the playbook sym-population survey
        // and usday systematic learnings (premium_ema 0.9, premium_tdc 60,
        // momentum tdc 5 / coef 0.5, vol_norm tdc 10 / coef 0.1, curv off).
        "premium_ema_coef": 0.9,
        "premium_tdc_s": 60,
        "curv_impulse_tdc": 30,
        "curv_impulse_coef": 0.0,
        "pred_momentum_tdc": 5,
        "pred_momentum_coef": 0.5,
        "vol_norm_tdc": 10,
        "vol_norm_coef": 0.1,
        "enable_queue_jump": false,
        "queue_jump_size_mult": 3,
        "equity_off_hour_vwap": false,
        "mm_gtc": false,
        "ladder_one_sided": false,
        "per_order_widen_frac": 0.5,
        "print_ords": true,
        "print_ords_every": 100
      },
      "signals": [
        {
          // Local leg: the Hyperliquid hip3 book we quote on.
          "name": "local_mid_softbank",
          "type": "SigMid",
          "symbol": "xyz:SOFTBANK",
          "books": [
            "Hyperliquid"
          ],
          "use_flagged": true,
          "sigformer_tag": "top_level_signal"
        },
        {
          // Remote leg: TSE 9984.T fed by Refinitiv, published (FX-converted
          // JPY->USD) into the TopBookEquity book as symbol SOFTBANK.
          "name": "remote_mid_softbank",
          "type": "SigQuoteMid",
          "symbol": "SOFTBANK",
          "books": [
            "TopBookEquity"
          ],
          "use_flagged": true,
          "sigformer_tag": "top_level_signal"
        }
      ],
      "tempos": [
        {
          // Requote trigger fires on each Refinitiv 9984.T (SOFTBANK) update.
          "name": "remote_tradecall_tempo_softbank",
          "type": "FinalTempo",
          "symbol": "SOFTBANK",
          "markets": [
            "TopBookEquity"
          ]
        }
      ],
      "extra_subs": []
    }
  ]
}
