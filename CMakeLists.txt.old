FetchContent_Declare(
  googletest
  GIT_REPOSITORY https://github.com/google/googletest
  GIT_TAG release-1.11.0
)

option(INSTALL_GTEST "Enable installation of gtest" OFF)

FetchContent_MakeAvailable(googletest)

include(GoogleTest)
enable_testing()


