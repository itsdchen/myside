FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Notes on noble-specific quirks vs jammy:
#  - Noble ships cmake 3.28 (>= 3.24), so we don't need the Kitware apt repo.
#  - Conan 1.59.0 (jammy's pin) is too old for noble: several conancenter
#    recipes (e.g. libtool/2.4.7) have been updated to require conan >= 1.60.
#    We pin to 1.60.0 — still conan 1.x, same recipe format, minimum bump.
#    conanfile.txt is what actually pins library versions, so noble + jammy
#    still target the same dep versions.
#  - Conan 1.60 still pins PyYAML <= 6.0 which has no Python 3.12 wheel and
#    fails to build, so we install Python 3.11 from deadsnakes for the
#    conan venv.
#  - Several of our pinned deps (notably ixwebsocket 11.4.3) have bare
#    uint8_t/uint16_t references that gcc 13 rejects because it dropped
#    transitive <cstdint> includes. Install gcc-12 (still in noble's repos)
#    and make it the default. This also matches what jammy uses, so the
#    produced libstdc++ ABI is identical.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg software-properties-common \
        build-essential cmake git pkg-config \
        gcc-12 g++-12 ccache ninja-build libzstd-dev mold \
        python3 python3-pip python3-venv \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-distutils \
    && rm -rf /var/lib/apt/lists/*

# Conan v1.60.0 still pins PyYAML <= 6.0, which has no Python 3.12 wheel and
# fails to build on noble's default Python. Install conan into a Python 3.11
# venv (3.11 has a prebuilt PyYAML 6.0 wheel). Tooling-only — our C++ build
# itself doesn't care which Python ran conan.
RUN python3.11 -m venv /opt/conan-venv \
    && /opt/conan-venv/bin/pip install --no-cache-dir "conan==1.60.0"
ENV PATH="/opt/conan-venv/bin:${PATH}"

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

# Caches (mounted from host for speed)
ENV CCACHE_DIR=/ccache
ENV CONAN_USER_HOME=/conan
RUN mkdir -p /ccache /conan

WORKDIR /src
